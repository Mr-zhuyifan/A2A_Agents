# SmartVoyage 环境变量示例
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 密钥请到对应平台申请后填入，切勿把真实值写进 .env.example

# ==================== 大模型配置 ====================
# DashScope（阿里云百炼）API Key
API_KEY=sk-your-dashscope-api-key
# API 基础 URL
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称（需与 API Key 支持的模型一致）
LLM_MODEL=qwen3.8-27b
# 温度参数（0-1，越小越确定）
LLM_TEMPERATURE=0.1
# 是否启用流式响应
LLM_STREAMING=True
# 是否启用思考模式
LLM_ENABLE_THINKING=False

# ==================== MySQL 数据库配置 ====================
# 本地运行填 localhost；Docker 运行时 docker-compose 会覆盖为 host.docker.internal
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=travel_rag
# docker/docker-compose.yml 中 MySQL 容器初始化用（可选）
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_APP_USER=vincent
MYSQL_APP_PASSWORD=your-app-user-password

# ==================== Milvus 向量数据库配置 ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== 和风天气（天气爬虫 utils/spider_weather.py） ====================
# 和风天气控制台中的 API Key
QWEATHER_API_KEY=your-qweather-api-key
# 和风天气 API Host（不同账号的专属域名不同，控制台可查；免费版可用 devapi.qweather.com）
QWEATHER_BASE_URL=https://devapi.qweather.com/v7/weather/30d

# ==================== 和风天气（天气 MCP 服务 mcp_server/mcp_weather_server.py） ====================
QWEATHER_MCP_API_KEY=your-qweather-mcp-api-key
QWEATHER_MCP_BASE_URL=https://devapi.qweather.com/v7/weather/30d

# ==================== MCP 服务器地址配置 ====================
TICKET_MCP_URL=http://localhost:8001/mcp
WEATHER_MCP_URL=http://localhost:8002/mcp
TRIP_MCP_URL=http://localhost:8003/mcp
IMAGE_MCP_URL=http://localhost:8004/mcp

# ==================== A2A 服务器地址配置 ====================
WEATHER_A2A_URL=http://localhost:5005
TICKET_A2A_URL=http://localhost:5006
TRIP_A2A_URL=http://localhost:5007
COPYWRITING_A2A_URL=http://localhost:5008

# ==================== 图片 MCP 配置 ====================
# 图源顺序，按顺序尝试，命中即返回
IMAGE_PROVIDER_ORDER=so360,bing
# 有图库 Key 时填写，留空则跳过对应图源
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
